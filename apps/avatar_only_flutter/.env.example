# Copy to `.env` and edit for your setup.
# Run: flutter run -d chrome --web-port 5175 --dart-define-from-file=.env
#
# .env is git-ignored at the repo root.

# ─── Mode A: split-plane (recommended, mirrors Mason's apimila-demo) ───

# Your mint proxy — see apps/mint_proxy_examples/. The proxy holds the
# sk_ key server-side; this app never sees it.
MINT_PROXY_URL=http://localhost:8787

# Your mock Candy brain — see apps/candy_demo/mock_candy_brain/. The
# SDK's `brain:` callback POSTs to this endpoint. In a real customer
# integration this URL points at Candy's own LLM service.
BRAIN_URL=http://localhost:9090/reply

# ─── Mode B: dev-direct (SDK holds sk_, prototypes only) ───
# Only used if MINT_PROXY_URL is unset or a direct-gateway URL. Never
# ship this mode in a real customer build.
# GATEWAY_BASE=https://api.2wai.ai
# SK_KEY=sk_test_...

# ─── Avatar identity ───
# Mila on the toolkit-demo tenant (`ten_0e2277049d82a22bbb02ed30`).
# Verified working 2026-08-16. Swap for your own tenant's avatar + voice.
AVATAR_ID=avt_441ad4d95906438490a85b79
VOICE_ID=vc_e72e888d566aca3a4e63fbe8
