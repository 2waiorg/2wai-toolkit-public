# Copy to `.env` in this directory and fill in real values.
# Run: flutter run -d chrome --web-port 5173 --dart-define-from-file=.env
#
# .env is git-ignored at the repo root; .env.example is the committed template.

# Server-side API key (Bearer). Fetch from staging with:
#   az containerapp secret show --name apimila-demo -g rg-2wai-staging \
#     --secret-name apimila-sk -o json
# Or ask Mason for a fresh test key. NEVER commit the real value.
SK_KEY=sk_test_REPLACE_ME

# Avatar + voice IDs — Mila on the toolkit-demo tenant
# (`ten_0e2277049d82a22bbb02ed30`). Verified 2026-08-16.
AVATAR_ID=avt_441ad4d95906438490a85b79
VOICE_ID=vc_e72e888d566aca3a4e63fbe8

# twai-api gateway. Direct — CORS is live on the gateway as of 2026-07-27
# (revision twai-api--0000003) with TWAI_CORS_ALLOWED_ORIGIN_REGEX
# matching any localhost / 127.0.0.1 port. The old cors_proxy.py workaround
# is gone; talk to the gateway directly from `flutter run`.
GATEWAY_BASE=https://api.2wai.ai
