# twai-api mint proxy — configuration.
#
# Copy this file to `.env` in the same directory. Never commit `.env` — it
# holds your sk_ secret key. `.gitignore` in this folder already excludes it.
#
# Only SK_KEY is required. Everything else has a working default.

# Your tenant's sk_ key. Held ONLY on this server; the browser never sees it.
# Get from the 2wai admin (or `az containerapp secret show` if you own the
# gateway).
SK_KEY=sk_test_REPLACE_ME

# Upstream twai-api gateway. Default targets the shared staging gateway.
# Override to hit prod or a customer-owned instance.
# UPSTREAM=https://twai-api.purpleglacier-ffec85d8.westus2.azurecontainerapps.io

# CORS allow-origin. Default '*' is fine for local dev. In production set to
# the exact origin(s) your app serves from — a wildcard is a foot-gun.
# ALLOWED_ORIGIN=https://your-app.com

# Port the proxy listens on. Match your app's MINT_PROXY_URL dart-define.
# PORT=8787

# 2wai brain endpoint used only by the /brain and /brain/stream routes (the
# BYO-brain demo path — e.g. apps/enlighten's streamingBrain sample). If your
# app owns its own LLM, ignore these — the SDK doesn't call /brain* unless
# you explicitly wire a streamingBrain callback.
# BRAIN_URL=http://20.221.72.255
# BRAIN_AVATAR=brian-alman
# BRAIN_MODEL=gpt-4o
# BRAIN_PROVIDER=openai
